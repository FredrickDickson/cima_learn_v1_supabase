modules = ["cpp-clang14", "swift-5.8", "c-clang14", "dart", "python-3.11", "flutter", "nodejs-20", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["flutter"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Flutter Web App"

[[workflows.workflow]]
name = "Flutter Web App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 flutter_server.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["python3", "flutter_server.py"]
build = ["flutter", "build", "web", "--dart-define=SUPABASE_URL=https://pgmtaemwcueobaexthaq.supabase.co", "--dart-define=SUPABASE_KEY=$SUPABASE_KEY", "--base-href", "/"]
